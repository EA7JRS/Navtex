# Navtex web GUI and JSON API (EA7JRS/Navtex). Installed by
# tools/instalar-servicios.sh, which replaces @USUARIO@.
[Unit]
Description=NAVTEX web interface
After=network.target

[Service]
Type=simple
User=@USUARIO@
Environment=WEB_PORT=8080
Environment=WEB_ADDRESS=0.0.0.0
Environment=NAVTEX_GPSD=127.0.0.1:2947
EnvironmentFile=-/etc/default/navtex
ExecStart=/usr/local/bin/navtexwebserver $WEB_PORT $WEB_ADDRESS
Restart=on-failure
RestartSec=5
# It only needs its own folder (the database is written there)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/Navtex
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
