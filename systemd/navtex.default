# /etc/default/navtex · ajustes del servicio navtex-web
# Tras cambiarlos:  sudo systemctl restart navtex-web

# Los receptores (equipo, banda, toma de antena, encendido) se ajustan en la
# interfaz web, pestaña «Receptores»: no hay nada que poner aquí para ellos.

# Interfaz web: puerto y dirección en la que escucha.
#   0.0.0.0    cualquier equipo de la red (abra el puerto en el cortafuegos)
#   127.0.0.1  solo este equipo
WEB_PORT=8080
WEB_ADDRESS=0.0.0.0

# Posición propia: gpsd del que se toma (equipo:puerto). Vacío, sin GPS.
NAVTEX_GPSD=127.0.0.1:2947
