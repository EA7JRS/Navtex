# Navtex receiver number %i (EA7JRS/Navtex). Installed by
# tools/instalar-servicios.sh, which replaces @USUARIO@ and adds the
# Conflicts= drop-in to receiver 1 when other programs share its radio.
# Which radio, which band and whether it is switched on are chosen in the
# web interface; the receiver follows those settings without restarting.
[Unit]
Description=NAVTEX receiver %i
# The SDRplay API service, when there is one, must be up first
After=network.target sdrplay.service
# Keep trying for as long as it takes: the receiver may be unplugged or in use
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USUARIO@
SupplementaryGroups=plugdev
WorkingDirectory=/opt/Navtex
ExecStart=/usr/local/bin/navtexreceiver -q -n %i
# It keeps trying by itself when the radio is missing or busy
Restart=on-failure
RestartSec=15
# SIGTERM makes it stop streaming and release the radio
TimeoutStopSec=20
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
